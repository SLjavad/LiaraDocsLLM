# Copy to .env and fill in real values locally. Never commit .env.
# See specs/02-technical-spec.md §8 for what each var does.
# Model identity (name/base URL/key) has NO in-code default — the app fails
# fast at startup if any required var below is unset (NFR2).

# Chat model (OpenAI-compatible)
CHAT_MODEL_BASE_URL=
CHAT_MODEL_API_KEY=
CHAT_MODEL_NAME=

# Router model — cheap model for scope-gate + query processing (§4)
ROUTER_MODEL_NAME=

# Embedding model (OpenAI-compatible; may be a different provider than chat)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=
EMBED_DIM=
# "query: "/"passage: " prefixing — required for nemotron-3-embed-1b, wrong
# for text-embedding-3-small (§7a)
EMBEDDING_USE_PREFIXES=true

# Only needed if EMBEDDING_* points at OpenRouter
OPENROUTER_API_KEY=

# Data stores
POSTGRES_CONNECTION_STRING=
REDIS_CONNECTION_STRING=

# Rate limiting / cost controls (NFR1, NFR8)
RATE_LIMIT_SESSION_PER_MIN=20
RATE_LIMIT_IP_PER_MIN=60
DAILY_SPEND_BUDGET_TOKENS=

# Retrieval (§7)
RETRIEVAL_TOP_K=5
RETRIEVAL_GROUNDEDNESS_THRESHOLD=0.5

# Triage (§5) / Practice Mode (§6a)
MAX_CLARIFYING_ROUNDS=2
PRACTICE_MIN_STEPS=3
PRACTICE_MAX_STEPS=6

# Ingestion (§2a) — seed path tried first, falls back to a live crawl
SEED_DOWNLOAD_URL=
# Only needed if the Object Storage bucket holding the seed is private
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
DOCS_SITEMAP_URL=https://docs.liara.ir/sitemap.xml
CRAWL_CONCURRENCY=5
CRAWL_DELAY_MS=300
EMBED_BATCH_SIZE=20

# Misc
MAX_INPUT_CHARS=2000
CORS_ALLOWED_ORIGIN=
SUPPORT_CHANNEL_URL=
